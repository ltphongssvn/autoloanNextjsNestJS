# apps/backend/.env.example
# Database
DATABASE_URL=postgresql://user:password@localhost:5432/autoloan_development # pragma: allowlist secret

# JWT
JWT_SECRET=your_jwt_secret_key_here # pragma: allowlist secret
JWT_EXPIRATION=3600

# SMTP
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password # pragma: allowlist secret

# App
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
